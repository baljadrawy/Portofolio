# Copy to .env.production and fill in. NEVER commit the real file.
# chmod 600 .env.production

NODE_ENV=production
PORT=3000

# Reached over the shared-db-network; shared-postgres is the container name.
DATABASE_URL=postgresql://portfolio_app:CHANGE_ME@shared-postgres:5432/portfolio

TZ=Asia/Riyadh

# Optional providers. Absence degrades the specific feature only —
# it does not prevent the application from starting or being healthy.
# COINMARKETCAP_API_KEY=
# ETHERSCAN_API_KEY=
# SOLSCAN_API_KEY=

# Demo seed is opt-in in production. Leave unset for real deployments.
# SEED_DEMO_DATA=true
